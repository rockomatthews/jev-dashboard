# Shared secret: the bot sends it as "Authorization: Bearer <secret>".
# Generate one:  openssl rand -hex 32   and put the SAME value in jev-agent/.env as DASHBOARD_INGEST_SECRET
INGEST_SECRET=

# Added automatically when you connect Upstash Redis from the Vercel Marketplace (Storage tab).
# Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
